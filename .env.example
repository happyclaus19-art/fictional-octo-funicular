# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
#   Copy-Item .env.example .env.local
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.

# ── 브라우저에 공개돼도 되는 값 (NEXT_PUBLIC_ 접두사) ──
# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 비밀 값 (절대 NEXT_PUBLIC_ 붙이지 말 것) ──
# RLS를 우회하는 관리자 키: 서버 라우트에서만 사용
SUPABASE_SERVICE_ROLE_KEY=
# Claude API 키 (P2 단계에서 사용)
ANTHROPIC_API_KEY=

# 학생 1명이 1분에 생성할 수 있는 최대 횟수 (비용 보호)
RATE_LIMIT_PER_MINUTE=5
